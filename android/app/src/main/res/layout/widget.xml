<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kala" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Нажмите, чтобы дать задачу" android:textColor="#9A9A9A" android:textSize="12sp" android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/w_voice" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="🎤" android:textSize="18sp" android:background="@drawable/widget_btn2" android:layout_marginEnd="8dp" />
    <TextView android:id="@+id/w_task" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Задача" android:textColor="#0A0A0A" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/widget_btn" />
</LinearLayout>
